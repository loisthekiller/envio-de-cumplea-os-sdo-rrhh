# WhatsApp Business Cloud API
# Obtén tus credenciales en: https://developers.facebook.com/apps

# Token de acceso permanente de WhatsApp Business
WHATSAPP_TOKEN=tu_token_aqui

# ID del número de teléfono de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# ID de la cuenta de negocio (opcional)
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_business_account_id_aqui

# Versión de la API de WhatsApp (recomendado: v18.0)
WHATSAPP_API_VERSION=v18.0

# Token para verificación de webhook (opcional, para recibir mensajes)
WEBHOOK_VERIFY_TOKEN=tu_webhook_verify_token_aqui

# Configuración del servidor
PORT=3000
HOST=localhost
NODE_ENV=production
